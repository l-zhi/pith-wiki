{
  "_comment": "API keys live in config.json (no .env). Two ways: a provider's literal \"apiKey\", or the \"secrets\" map below keyed by the provider's \"apiKeyEnv\" / a skill's auth_env. secrets is loaded into process.env at startup. chmod 600 this file — it holds plaintext keys.",

  "providers": {
    "deepseek": {
      "baseURL": "https://api.deepseek.com",
      "model": "deepseek-chat",
      "apiKey": "sk-your-deepseek-key"
    },
    "qwen": {
      "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen-plus",
      "apiKeyEnv": "DASHSCOPE_API_KEY"
    },
    "openai": {
      "baseURL": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "apiKeyEnv": "OPENAI_API_KEY"
    },
    "ollama-local": {
      "baseURL": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:14b",
      "apiKey": "ollama-no-key-needed"
    }
  },

  "secrets": {
    "DASHSCOPE_API_KEY": "sk-your-qwen-key",
    "OPENAI_API_KEY": "sk-your-openai-key",
    "WEREAD_API_KEY": "wrk-your-weread-skill-key"
  },

  "activeProvider": "deepseek",

  "wikiRoot": "~/.pith-wiki/wiki-data",
  "workspaceRoot": "~/code/my-project",

  "additionalReadPaths": [
    "~/notes",
    "~/research/papers"
  ],

  "watchDirs": [
    {
      "path": "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/MyVault",
      "collectionFromSubdir": true,
      "fallbackCollection": "inbox",
      "subdirAlias": {
        "工作": "work",
        "读书": "reading"
      },
      "initialScan": false
    }
  ],
  "watchAutoStart": true,

  "queueConcurrency": 2,
  "queueMaxAttempts": 3,
  "queueAutoStart": true,

  "outputDir": "~/.pith-wiki/wiki-data/output/transcripts",
  "transcriptEnabled": true,
  "digestCollection": "output",

  "cacheConverted": true,

  "soulFile": "~/.pith-wiki/SOUL.md",

  "maxToolPayloadBytes": 100000
}
