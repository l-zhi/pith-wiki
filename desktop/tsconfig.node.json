{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["../src/*"] }
  },
  "include": [
    "src/shared/**/*",
    "src/engine/**/*",
    "src/main/**/*",
    "src/preload/index.ts",
    "tests/**/*",
    "electron.vite.config.ts",
    "../src/**/*.ts"
  ],
  "exclude": ["../src/cli/initInteractive.ts"]
}
