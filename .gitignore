# --- dependencies & build ---
node_modules/
dist/
*.tsbuildinfo

# `npm pack` 产物（release-check 用）。不该入库。
pith-wiki-*.tgz

# 偶尔有人误用 bun 跑命令会生成这个；项目用 npm，bun.lock 不入库。
bun.lock

# --- secrets & local config ---
.env
.env.*
!.env.example

# --- logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- test & coverage ---
coverage/
.vitest/
.nyc_output/

# --- editor / IDE ---
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- runtime / temp ---
*.tmp
*.pid
*.seed
.cache/

# --- pith-wiki local data ---
# Wiki 默认存放在 ~/.pith-wiki/wiki-data（不在 repo 内，自然被忽略）。
# 如果用户用 PITH_WIKI_ROOT 或配置把 wikiRoot 指回项目内的 ./wiki-data，
# 这一条保证那份本地数据不会被误提交。
/wiki-data/

# 旧默认 / 用户重写过的 transcript 输出目录。当前默认 outputDir 是
# <wikiRoot>/output/transcripts/，跟 wikiRoot 同根。下面这条是给把 outputDir
# 设回项目 cwd 的用户兜底。
/output/

# Per-user history & local config
.pith-wiki/

# --- Claude Code local artifacts ---
.claude/
.agents/
skills-lock.json
plans/

# --- internal-only docs / design artifacts (not for GitHub) ---
# Whole standalone TUI mockups, large HTML prototypes — not user-facing.
design/
# ADRs and agent skill notes are internal product context, kept out of the
# public repo. The user-facing docs in docs/*.md and docs/screenshots/ stay.
docs/adr/
docs/agents/
