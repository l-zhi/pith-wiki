{
  "name": "llm-wiki",
  "version": "0.1.0",
  "description": "Karpathy-style LLM wiki CLI: chat with DeepSeek, read/write files, hydrate raw text into a Markdown knowledge base.",
  "type": "module",
  "license": "MIT",
  "author": "l-zhi",
  "homepage": "https://github.com/l-zhi/llm-wiki#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-zhi/llm-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/l-zhi/llm-wiki/issues"
  },
  "keywords": [
    "cli",
    "llm",
    "deepseek",
    "wiki",
    "knowledge-base",
    "markdown",
    "ink",
    "claude-code"
  ],
  "bin": {
    "llm-wiki": "./dist/bin/llm-wiki.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx bin/llm-wiki.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/llm-wiki.js",
    "start": "node dist/bin/llm-wiki.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.71.1",
    "p-queue": "^8.0.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
