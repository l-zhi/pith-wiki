{
  "name": "llm-wiki",
  "version": "0.2.0-beta.0",
  "description": "Karpathy-style LLM wiki: a CLI plus an embeddable library (LibraryService, Agent, ContextAssembler) for chatting with an LLM-driven Markdown knowledge base.",
  "type": "module",
  "license": "MIT",
  "author": "l-zhi",
  "homepage": "https://github.com/l-zhi/llm-wiki#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-zhi/llm-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/l-zhi/llm-wiki/issues"
  },
  "keywords": [
    "cli",
    "llm",
    "deepseek",
    "wiki",
    "knowledge-base",
    "markdown",
    "ink",
    "claude-code",
    "library",
    "embeddable",
    "electron"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./wiki": {
      "types": "./dist/src/wiki/index.d.ts",
      "import": "./dist/src/wiki/index.js"
    },
    "./agent": {
      "types": "./dist/src/llm/index.d.ts",
      "import": "./dist/src/llm/index.js"
    },
    "./tools": {
      "types": "./dist/src/tools/index.d.ts",
      "import": "./dist/src/tools/index.js"
    },
    "./config": {
      "types": "./dist/src/config.d.ts",
      "import": "./dist/src/config.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "llm-wiki": "./dist/bin/llm-wiki.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx bin/llm-wiki.ts",
    "build": "tsc -p tsconfig.lib.json && tsc -p tsconfig.cli.json && chmod +x dist/bin/llm-wiki.js",
    "start": "node dist/bin/llm-wiki.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-no-cli-leak.mjs"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "mailparser": "^3.9.8",
    "mammoth": "^1.12.0",
    "openai": "^4.71.1",
    "p-queue": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "turndown": "^7.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
