{
  "name": "pith-wiki",
  "version": "0.2.0",
  "description": "Karpathy-style LLM knowledge base CLI: hydrate raw docs into dense Markdown entries; retrieve by keyword + link traversal. No embeddings, no vector DB, files all the way down.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "l-zhi",
  "homepage": "https://github.com/l-zhi/pith-wiki#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-zhi/pith-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/l-zhi/pith-wiki/issues"
  },
  "keywords": [
    "cli",
    "llm",
    "deepseek",
    "wiki",
    "knowledge-base",
    "markdown",
    "ink",
    "claude-code",
    "pith",
    "hydration"
  ],
  "bin": {
    "pith-wiki": "./dist/bin/pith-wiki.js"
  },
  "files": [
    "dist",
    "bundled-skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "tsx bin/pith-wiki.ts",
    "build": "tsc && chmod +x dist/bin/pith-wiki.js",
    "start": "node dist/bin/pith-wiki.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"bin/**/*.ts\"",
    "release:check": "bash scripts/release-check.sh"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "mailparser": "^3.9.8",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "openai": "^4.71.1",
    "p-queue": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "terminal-link": "^5.0.0",
    "turndown": "^7.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^2.1.4"
  }
}
